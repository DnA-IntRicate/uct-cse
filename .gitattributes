# Auto detect text files and perform LF normalization
* text=auto

###############################################################################
# Excludes source code files from being indexed
# by GitHub Linguist.
###############################################################################
**/Drivers/**   linguist-vendored=true
**/Makefile     linguist-vendored=true
**/makefile     linguist-vendored=true
**/GNUmakefile  linguist-vendored=true
**/*.make       linguist-vendored=true
