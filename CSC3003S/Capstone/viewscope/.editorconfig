# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Global defaults
[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
charset = utf-8

# Preserve whitespace for Markdown
[*.md]
trim_trailing_whitespace = false

# Two-space indentation for YAML
[*.yml]
indent_size = 2
tab_width = 2
[*.yaml]
indent_size = 2
tab_width = 2

# Two-space indentation for git configuration files
[.git*]
indent_size = 2
tab_width = 2

# .gitmodules Requires tabs
[.gitmodules]
indent_style = tab
