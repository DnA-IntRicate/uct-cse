# EditorConfig is awesome: https://EditorConfig.org

# Unix-Style newlines with a newline ending every file
[*.java]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
charset = utf-8
curly_bracket_next_line = true

[Makefile]
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
charset = utf-8
